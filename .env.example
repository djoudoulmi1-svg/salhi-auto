NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported if a publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# One-time owner setup secret; use a long random value and never commit .env.local.
SALHI_SETUP_TOKEN=
